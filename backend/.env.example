SUPABASE_DB_URL=jdbc:postgresql://your-supabase-host:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=your-database-user
SUPABASE_DB_PASSWORD=your-database-password

# Use your deployed Vercel origin in Render. Multiple origins are comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000
PORT=8080

# Flyway owns production schema changes; Hibernate only checks that entities match it.
JPA_DDL_AUTO=validate
# Set true only for the first Flyway deployment to an existing Hibernate-created schema.
FLYWAY_BASELINE_ON_MIGRATE=false
JPA_SHOW_SQL=false

# Must be a Base64-encoded string of at least 32 random bytes (256-bit key)
JWT_SECRET=your-base64-encoded-32-byte-secret
JWT_ISSUER=ecom-backend
JWT_AUDIENCE=ecom-api
JWT_ACCESS_TOKEN_TTL=PT15M

# Authentication abuse protection. Limits are per application instance.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_CACHE_MAX_ENTRIES=10000
AUTH_LOGIN_RATE_LIMIT_PER_IDENTITY=5
AUTH_LOGIN_RATE_LIMIT_GLOBAL=100
AUTH_LOGIN_RATE_LIMIT_PERIOD=PT1M
AUTH_REGISTRATION_RATE_LIMIT_PER_IDENTITY=3
AUTH_REGISTRATION_RATE_LIMIT_GLOBAL=30
AUTH_REGISTRATION_RATE_LIMIT_PERIOD=PT1H

# Checkout abuse protection. Limits are per application instance.
CHECKOUT_RATE_LIMIT_ENABLED=true
CHECKOUT_RATE_LIMIT_CACHE_MAX_ENTRIES=10000
CHECKOUT_RATE_LIMIT_PER_USER=3
CHECKOUT_RATE_LIMIT_GLOBAL=100
CHECKOUT_RATE_LIMIT_PERIOD=PT15M

# Supabase Storage S3 settings for user/admin profile images.
# Keep access keys server-side only. Never expose them through NEXT_PUBLIC_* variables.
AVATAR_STORAGE_ENABLED=false
SUPABASE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-northeast-1
SUPABASE_S3_ACCESS_KEY=your-server-side-access-key
SUPABASE_S3_SECRET_KEY=your-server-side-secret-key
SUPABASE_AVATAR_BUCKET=image
SUPABASE_STORAGE_PUBLIC_URL=https://your-project-ref.supabase.co/storage/v1/object/public
AVATAR_MAX_FILE_SIZE=5MB
AVATAR_MAX_REQUEST_SIZE=6MB

# Supabase Storage bucket for storefront product images.
PRODUCT_IMAGE_STORAGE_ENABLED=false
SUPABASE_PRODUCT_IMAGE_BUCKET=image
PRODUCT_IMAGE_MAX_FILE_SIZE=5MB

# Supabase Storage bucket for category images.
CATEGORY_IMAGE_STORAGE_ENABLED=false
SUPABASE_CATEGORY_IMAGE_BUCKET=image
CATEGORY_IMAGE_MAX_FILE_SIZE=5MB
